generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StageHistorySource {
  WEBHOOK
  SYNC
}

enum StaffRole {
  ADMIN
  EMPLOYEE
}

enum DocumentStatus {
  NOT_UPLOADED
  UPLOADED
  SUBMITTED_FOR_REVIEW
  APPROVED
  REJECTED
}

model TenantConfig {
  id        String   @id @default(uuid())
  config    Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("tenant_config")
}

model Contact {
  id             String   @id @default(uuid())
  zohoContactId  String   @unique @map("zoho_contact_id")
  // Nullable: resolved lazily on first ticket creation (search/create against
  // Desk), not backfilled by the CRM contact sync. A collision here would mean
  // two local contacts got bridged to the same Desk contact — real data
  // corruption worth failing loudly on, hence @unique rather than a soft check.
  deskContactId  String?  @unique @map("desk_contact_id")
  mobileE164     String   @unique @map("mobile_e164")
  altMobileE164  String?  @map("alt_mobile_e164")
  fullName       String?  @map("full_name")
  email          String?
  raw            Json
  syncedAt       DateTime @map("synced_at")
  // Set true when staff submits a document checklist for review (see
  // Document below), cleared once the customer has responded to every
  // SUBMITTED_FOR_REVIEW document — a real stored flag (not purely computed)
  // so the app can show a badge without re-scanning every document row on
  // each read. Deliberately no push on set — customer sees it on next open.
  pendingCustomerReview Boolean @default(false) @map("pending_customer_review")

  journeys       Journey[]
  sessions       Session[]
  deviceTokens   DeviceToken[]
  tickets        Ticket[]
  documents      Document[]

  @@index([altMobileE164])
  @@map("contacts")
}

model Journey {
  id            String   @id @default(uuid())
  zohoRecordId  String   @unique @map("zoho_record_id")
  contactId     String   @map("contact_id")
  name          String
  stage         String
  stageIndex    Int?     @map("stage_index")
  refValues     Json     @map("ref_values")
  raw           Json
  syncedAt      DateTime @map("synced_at")
  // Zoho's Owner.id for this Sales_Order/journey record (a standard CRM v8
  // lookup field, {id, name, email}) — powers staff/employee customer
  // scoping (M9): an employee only sees contacts whose journey Owner matches
  // their own staff_users.zoho_owner_id. Nullable/indexed since it's fetched
  // going forward, not backfilled retroactively until the next full sync.
  ownerZohoId   String?  @map("owner_zoho_id")

  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stageHistory  StageHistory[]
  documents     Document[]

  @@index([ownerZohoId])
  @@map("journeys")
}

model StageHistory {
  id         String             @id @default(uuid())
  journeyId  String             @map("journey_id")
  fromStage  String?            @map("from_stage")
  toStage    String             @map("to_stage")
  changedAt  DateTime           @map("changed_at")
  source     StageHistorySource
  // `${journeyId}:${toStage}:${minuteBucket}` — real DB-level idempotency for
  // webhook redelivery (PRD §11.2: dedupe on record_id + to_stage + minute
  // bucket) instead of a race-prone check-then-insert. A duplicate delivery
  // hits this unique constraint (P2002), caught and treated as a no-op.
  dedupeKey  String             @unique @map("dedupe_key")

  journey    Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@map("stage_history")
}

model Ticket {
  id            String    @id @default(uuid())
  deskTicketId  String    @unique @map("desk_ticket_id")
  contactId     String    @map("contact_id")
  ticketNumber  String    @map("ticket_number")
  subject       String
  description   String?
  category      String?
  status        String
  statusDisplay String    @map("status_display")
  ownerName     String?   @map("owner_name")
  coOwnerName   String?   @map("co_owner_name")
  priority      String?
  // Mirrors Desk's own closedTime (confirmed live: ISO timestamp set the
  // moment status flips to Closed, cleared back to null on reopen) — not
  // derived/computed locally, so a reopen-then-reclose is reflected exactly
  // as Desk reports it, no local state to drift.
  closedAt      DateTime? @map("closed_at")
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")
  // Local write timestamp, distinct from createdAt/updatedAt (which mirror
  // Desk's own createdTime/modifiedTime) — lets sync tell "when did our copy
  // last touch this row" apart from "when did Zoho's record last change."
  syncedAt      DateTime  @map("synced_at")
  raw           Json

  contact       Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("tickets")
}

// Staff/employee back office (M9) — deliberately separate from Contact/
// Session: a wholly different auth namespace (email+password, not OTP),
// different JWT audience (see src/lib/staff-jwt.ts), different data scope
// (Zoho CRM Owner-based, not "logged in as me").
model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         StaffRole
  // Zoho CRM user id (Owner.id on a Sales_Orders record) — null for an admin
  // who doesn't need customer-scoping (admins see everyone regardless), set
  // for an employee so GET /staff/customers can scope to their own accounts.
  zohoOwnerId  String?   @map("zoho_owner_id")
  fullName     String?   @map("full_name")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")

  sessions                 StaffSession[]
  uploadedDocuments        Document[]        @relation("DocumentUploadedBy")
  uploadedDocumentVersions DocumentVersion[] @relation("DocumentVersionUploadedBy")

  @@map("staff_users")
}

// Mirrors Session exactly (staffId instead of contactId) — same jti-based
// server-side revocation model.
model StaffSession {
  id        String    @id @default(uuid())
  staffId   String    @map("staff_id")
  jti       String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_sessions")
}

// One row per (contact, document_key) — created lazily on first staff
// upload, never pre-seeded for every configured document key. GET endpoints
// (both staff and customer) synthesize NOT_UPLOADED placeholders for any
// configured key with no row yet — see src/lib/document-view.ts.
model Document {
  id               String         @id @default(uuid())
  contactId        String         @map("contact_id")
  // Nullable: a document can't be pushed to Zoho as an Attachment until the
  // contact has a resolvable Sales_Order/journey to attach it to — see the
  // upload route's journey-resolution logic.
  journeyId        String?        @map("journey_id")
  documentKey      String         @map("document_key")
  stageGroupKey    String         @map("stage_group_key")
  fileName         String?        @map("file_name")
  fileSize         Int?           @map("file_size")
  zohoAttachmentId String?        @map("zoho_attachment_id")
  status           DocumentStatus @default(NOT_UPLOADED)
  uploadedById     String?        @map("uploaded_by")
  uploadedAt       DateTime?      @map("uploaded_at")
  reviewedAt       DateTime?      @map("reviewed_at")
  reviewNote       String?        @map("review_note")

  contact    Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  journey    Journey?          @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  uploadedBy StaffUser?        @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  versions   DocumentVersion[]

  @@unique([contactId, documentKey])
  @@index([contactId])
  @@map("documents")
}

// Append-only upload history per Document — mirrors StageHistory's
// relationship to Journey (Document holds "current" state, mutated in
// place on every re-upload, exactly as before; DocumentVersion is the full
// audit trail). Nothing in the approval workflow (document-view.ts,
// submit-for-review, customer respond) reads this table — it exists purely
// so a re-upload to the same document_key never silently discards the
// previous file, since each version lands in Zoho as its own distinctly
// -named attachment (see buildAttachmentFilename in staff-customers.ts).
model DocumentVersion {
  id               String   @id @default(uuid())
  documentId       String   @map("document_id")
  versionNumber    Int      @map("version_number")
  fileName         String   @map("file_name")
  fileSize         Int      @map("file_size")
  zohoAttachmentId String   @map("zoho_attachment_id")
  uploadedById     String?  @map("uploaded_by")
  uploadedAt       DateTime @map("uploaded_at")

  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy StaffUser? @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

model OtpAttempt {
  id         String   @id @default(uuid())
  mobileE164 String   @map("mobile_e164")
  attempts   Int      @default(0)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("otp_attempts")
}

model Session {
  id         String    @id @default(uuid())
  contactId  String    @map("contact_id")
  jti        String    @unique
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  contact    Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model DeviceToken {
  id         String   @id @default(uuid())
  contactId  String   @map("contact_id")
  // Unique so re-registering the same physical device (relaunch, re-login,
  // reinstall) upserts in place instead of accumulating duplicate rows that
  // would each receive their own copy of every push.
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now()) @map("created_at")

  contact    Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

// One row per sync stream ('incremental' | 'full_reconcile'). Feeds /healthz/sync.
model SyncState {
  id                String    @id @default(uuid())
  key               String    @unique
  watermark         DateTime?
  lastRunAt         DateTime? @map("last_run_at")
  lastRunStatus     String?   @map("last_run_status")
  contactsProcessed Int       @default(0) @map("contacts_processed")
  journeysProcessed Int       @default(0) @map("journeys_processed")
  ticketsProcessed  Int       @default(0) @map("tickets_processed")
  issuesCount       Int       @default(0) @map("issues_count")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Checkpoint for interruption-resilient runs (Fix 5). Written in the same
  // transaction as each page's batch commit, so it can never drift from
  // actual data. Non-null checkpointPhase means a run is (or was) mid-flight;
  // on startup this is what "resume from page N" reads from instead of
  // restarting at page 1. checkpointSinceIso/checkpointRunStartedAt are the
  // *original* run's values, reused verbatim on resume rather than
  // recomputed, so the eventual watermark reflects when the run actually
  // started, not when it happened to finish.
  checkpointPhase        String?   @map("checkpoint_phase")
  checkpointPageToken    String?   @map("checkpoint_page_token")
  checkpointPagesDone    Int       @default(0) @map("checkpoint_pages_done")
  checkpointSinceIso     String?   @map("checkpoint_since_iso")
  checkpointRunStartedAt DateTime? @map("checkpoint_run_started_at")

  @@map("sync_state")
}

// Diagnostic log: bad phone numbers, unknown stages, orphan journeys, duplicate mobiles.
// Deduped on (zohoRecordId, field, reason) via skipDuplicates — one row per
// distinct problem, not one row per occurrence across every sync run.
model SyncIssue {
  id           String   @id @default(uuid())
  zohoRecordId String?  @map("zoho_record_id")
  recordType   String   @map("record_type")
  field        String?
  rawValue     String?  @map("raw_value")
  reason       String
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([zohoRecordId, field, reason])
  @@index([recordType, createdAt])
  @@map("sync_issues")
}
